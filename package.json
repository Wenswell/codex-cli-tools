{
  "name": "codex-tools",
  "version": "0.2.57",
  "description": "Personal Codex CLI helpers",
  "type": "module",
  "bin": {
    "ccs": "dist/bin/ccs.js",
    "ccx": "dist/bin/ccx.js",
    "ccxs": "dist/bin/ccxs.js",
    "clvm": "dist/bin/clvm.js",
    "cx": "dist/bin/cx.js",
    "cxx": "dist/bin/cxx.js",
    "cxxs": "dist/bin/cxxs.js",
    "senv": "dist/bin/senv.js",
    "codex-rename": "dist/bin/codex-rename.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/bin/*.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "diff": "^9.0.0",
    "luxon": "^3.7.2",
    "slice-ansi": "^9.0.0",
    "string-width": "^8.2.1",
    "strip-ansi": "^7.2.0"
  }
}
