  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "asciichart": "^1.5.25",
    "diff": "^9.0.0",
    "luxon": "^3.7.2"
  }
