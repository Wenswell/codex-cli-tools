{
  "name": "codex-tools",
  "version": "0.1.0",
  "description": "Personal Codex CLI helpers",
  "type": "module",
  "bin": {
    "ccs": "./dist/bin/ccs.js",
    "cx": "./dist/bin/cx.js",
    "cxx": "./dist/bin/cxx.js",
    "cxxs": "./dist/bin/cxxs.js",
    "envsync": "./dist/bin/envsync.js",
    "codex-session-move": "./dist/bin/codex-session-move.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "diff": "^9.0.0"
  }
}
